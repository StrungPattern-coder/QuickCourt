{
  "installCommand": "npm install --include=dev && npm install --prefix server --include=dev",
  "buildCommand": "npm run build && npm --prefix server run prisma:generate && npm --prefix server run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/auth", "destination": "/api?path=/auth" },
    { "source": "/auth/:path*", "destination": "/api?path=/auth/:path*" },
    { "source": "/facilities", "destination": "/api?path=/facilities" },
    { "source": "/facilities/:path*", "destination": "/api?path=/facilities/:path*" },
    { "source": "/courts", "destination": "/api?path=/courts" },
    { "source": "/courts/:path*", "destination": "/api?path=/courts/:path*" },
    { "source": "/bookings", "destination": "/api?path=/bookings" },
    { "source": "/bookings/:path*", "destination": "/api?path=/bookings/:path*" },
    { "source": "/admin", "destination": "/api?path=/admin" },
    { "source": "/admin/:path*", "destination": "/api?path=/admin/:path*" },
    { "source": "/reviews", "destination": "/api?path=/reviews" },
    { "source": "/reviews/:path*", "destination": "/api?path=/reviews/:path*" },
    { "source": "/loyalty", "destination": "/api?path=/loyalty" },
    { "source": "/loyalty/:path*", "destination": "/api?path=/loyalty/:path*" },
    { "source": "/badges", "destination": "/api?path=/badges" },
    { "source": "/badges/:path*", "destination": "/api?path=/badges/:path*" },
    { "source": "/upload", "destination": "/api?path=/upload" },
    { "source": "/upload/:path*", "destination": "/api?path=/upload/:path*" },
    { "source": "/payments", "destination": "/api?path=/payments" },
    { "source": "/payments/:path*", "destination": "/api?path=/payments/:path*" },
    { "source": "/uploads/:path*", "destination": "/api?path=/uploads/:path*" },
    { "source": "/health", "destination": "/api?path=/health" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
